{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepSeek Harness",
  "version": "0.1.7",
  "identifier": "ai.deepseek.harness.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "DeepSeek Harness",
        "width": 1280,
        "height": 820,
        "minWidth": 760,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../resources/backend": "backend"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "DeepSeek Harness desktop app",
    "longDescription": "A native desktop shell for the DeepSeek Harness coding agent (dsh web): it runs the harness backend locally and wraps the browser UI in a native window with a menu bar and system tray.",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczRDE3NkY0RjYxMkEzQjUKUldTMW94TDI5SGJSYzhZb3k0V0FoRTg1RGtQZ1VlaUcxN2Y0UGJMZE5GWGtFRzFUUUhqd3ZreDcK",
      "endpoints": [
        "https://deepseek-harness-desktop.oss-cn-hongkong.aliyuncs.com/latest.json",
        "https://github.com/xingj404-lab/dsh-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
